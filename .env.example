# --- Mode ---------------------------------------------------------------
# env         single tenant, no login. What a self-hoster runs.
# plex-oauth  multi tenant, everyone signs in with their own Plex account.
AUTH_MODE=env

# --- Source: Tautulli (preferred) ---------------------------------------
# Tautulli keeps history independently of Plex, which prunes its own, and it
# has clean per-user attribution. Key: Settings -> Web Interface -> API.
TAUTULLI_URL=http://192.168.1.10:8181
TAUTULLI_APIKEY=

# --- Source: Plex direct (fallback) -------------------------------------
# PLEX_URL is env-only and is never accepted from the browser. Accepting a
# URL from a visitor would be server-side request forgery.
#
# Plex enforces a host-header allowlist: reaching it from another machine over
# plain LAN returns an EMPTY reply. If Plex runs on this same host, use
# network_mode: host in docker-compose.yml and localhost here.
#PLEX_URL=http://localhost:32400
#PLEX_TOKEN=

# --- Transform -----------------------------------------------------------
# Dates are converted to this zone BEFORE being truncated to YYYY-MM-DD, so a
# film finished at 11pm does not land on tomorrow. IANA name.
DISPLAY_TIMEZONE=UTC

# Percent watched required to count as a viewing. Tautulli source only; Plex
# history has no completion percentage.
COMPLETION_THRESHOLD=85

# Letterboxd caps uploads at 1MB. Exports above this split into parts.
CSV_CHUNK_BYTES=900000

# --- Hosted mode only (AUTH_MODE=plex-oauth) -----------------------------
# 32+ characters. Generate with: openssl rand -hex 32
#SESSION_SECRET=
#SESSION_TTL_SECONDS=1800
#PUBLIC_BASE_URL=https://boxd.example.com

# Cookies carry the Secure flag by default. Set false ONLY for local HTTP.
#COOKIE_SECURE=true

# Sign-in attempts per window, per IP. Keeps this instance from spamming plex.tv.
#RATE_LIMIT_REQUESTS=5
#RATE_LIMIT_WINDOW_SECONDS=300
